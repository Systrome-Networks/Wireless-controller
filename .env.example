# ==============================================================================
# Systrome WAC Enterprise Controller — Environment Configuration
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Host Exposed Ports
PORT_WEB=3000
PORT_API=4000
PORT_DB=5432
PORT_REDIS=6379
PORT_RADIUS_AUTH=1812
PORT_RADIUS_ACCT=1813
PORT_RADIUS_COA=3799

# PostgreSQL Configuration
POSTGRES_USER=wac
POSTGRES_PASSWORD=wac_secret_2026
POSTGRES_DB=wac_db

# Database Connection URL (used internally by backend & Prisma)
DATABASE_URL=postgresql://wac:wac_secret_2026@db:5432/wac_db?schema=public

# Redis Cache & PubSub
REDIS_URL=redis://redis:6379

# JWT Authentication Secrets
JWT_SECRET=wac_super_secure_enterprise_jwt_secret_2026_xyz!
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=wac_refresh_token_secret_key_2026_abc!
JWT_REFRESH_EXPIRES_IN=7d

# FreeRADIUS AAA Shared Secret
RADIUS_SECRET=RadiusSecretKey123
