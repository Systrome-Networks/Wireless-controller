{
  "name": "wireless-controller-root",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Multi-Vendor Wireless Access Controller (WAC)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@wac/database",
    "db:push": "npm run push --workspace=@wac/database",
    "db:seed": "npm run seed --workspace=@wac/database",
    "dev:server": "npm run dev --workspace=@wac/server",
    "dev:web": "npm run dev --workspace=@wac/web",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
